        "typography": {
            "defaultFontSizes": false,
            "fluid": {
                "minViewportWidth": "375px",
                "maxViewportWidth": "1440px"
            },
            "fontFamilies": [
                {
                    "name": "Titling Gothic FB Wide",
                    "slug": "titling-gothic-fb-wide",
                    "fontFamily": "\"Titling Gothic FB Wide\", \"Arial Black\", Helvetica, Arial, sans-serif",
                    "fontFace": [
                        {
                            "src": ["file:./assets/fonts/titlinggothicfbwide/TitlingGothicFBWide-Light.woff2"],
                            "fontWeight": "300",
                            "fontStyle": "normal",
                            "fontFamily": "\"Titling Gothic FB Wide\""
                        },
                        {
                            "src": ["file:./assets/fonts/titlinggothicfbwide/TitlingGothicFBWide-Stand.woff2"],
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontFamily": "\"Titling Gothic FB Wide\""
                        },
                        {
                            "src": ["file:./assets/fonts/titlinggothicfbwide/TitlingGothicFBWide-Medium.woff2"],
                            "fontWeight": "500",
                            "fontStyle": "normal",
