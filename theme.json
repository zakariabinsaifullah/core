                            "fontStyle": "normal",
                            "fontFamily": "\"Titling Gothic FB Wide\""
                        }
                    ]
                },
                {
                    "name": "Instrument Sans",
                    "slug": "instrument-sans",
                    "fontFamily": "\"Instrument Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
                    "fontFace": [
                        {
                            "src": ["file:./assets/fonts/instrument-sans/instrument-sans-400-normal.woff2"],
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontFamily": "\"Instrument Sans\""
                        },
                        {
                            "src": ["file:./assets/fonts/instrument-sans/instrument-sans-400-italic.woff2"],
                            "fontWeight": "400",
                            "fontStyle": "italic",
                            "fontFamily": "\"Instrument Sans\""
                        },
                        {
                            "src": ["file:./assets/fonts/instrument-sans/instrument-sans-500-normal.woff2"],
                            "fontWeight": "500",
                            "fontStyle": "normal",
                            "fontFamily": "\"Instrument Sans\""
                        },
                        {
                            "src": ["file:./assets/fonts/instrument-sans/instrument-sans-500-italic.woff2"],
                            "fontWeight": "500",
                            "fontStyle": "italic",
                            "fontFamily": "\"Instrument Sans\""
                        },
                        {
                            "src": ["file:./assets/fonts/instrument-sans/instrument-sans-600-normal.woff2"],
                            "fontWeight": "600",
                            "fontStyle": "normal",
                            "fontFamily": "\"Instrument Sans\""
                        },
                        {
                            "src": ["file:./assets/fonts/instrument-sans/instrument-sans-600-italic.woff2"],
                            "fontWeight": "600",
                            "fontStyle": "italic",
                            "fontFamily": "\"Instrument Sans\""
                        },
                        {
                            "src": ["file:./assets/fonts/instrument-sans/instrument-sans-700-normal.woff2"],
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontFamily": "\"Instrument Sans\""
                        },
                        {
                            "src": ["file:./assets/fonts/instrument-sans/instrument-sans-700-italic.woff2"],
                            "fontWeight": "700",
                            "fontStyle": "italic",
                            "fontFamily": "\"Instrument Sans\""
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "name": "Display",
                    "size": "80px",
                    "slug": "core-theme-display",
                    "fluid": { "min": "48px", "max": "80px" }
                },
                {
                    "name": "Heading One",
                    "size": "64px",
                    "slug": "core-theme-heading-one",
                    "fluid": { "min": "36px", "max": "64px" }
                },
                {
                    "name": "Heading Two",
                    "size": "48px",
                    "slug": "core-theme-heading-two",
                    "fluid": { "min": "32px", "max": "48px" }
                },
                {
                    "name": "Heading Three",
                    "size": "44px",
                    "slug": "core-theme-heading-three",
                    "fluid": { "min": "28px", "max": "44px" }
                },
                {
                    "name": "Heading Four",
                    "size": "36px",
                    "slug": "core-theme-heading-four",
                    "fluid": { "min": "24px", "max": "36px" }
                },
                {
                    "name": "Heading Five",
                    "size": "28px",
                    "slug": "core-theme-heading-five",
                    "fluid": { "min": "20px", "max": "28px" }
                },
                {
                    "name": "Heading Six",
                    "size": "22px",
                    "slug": "core-theme-heading-six",
                    "fluid": { "min": "18px", "max": "22px" }
                },
                {
                    "fluid": false,
                    "name": "Extra Large",
                    "size": "20px",
                    "slug": "core-theme-extra-large"
                },
                {
                    "fluid": false,
                    "name": "Large",
                    "size": "18px",
                    "slug": "core-theme-large"
                },
                {
                    "fluid": false,
                    "name": "Medium",
                    "size": "16px",
                    "slug": "core-theme-medium"
                },
                {
                    "fluid": false,
                    "name": "Small",
                    "size": "14px",
                    "slug": "core-theme-small"
                }
            ],
            "writingMode": true
        },
        "layout": {
            "contentSize": "1310px",
            "wideSize": "1440px"
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Default Shadow",
                    "shadow": "0 0 11.5px 0 #8FA4B7",
                    "slug": "core-theme-shadow"
                },
                {
                    "name": "Soft Shadow",
                    "shadow": "0 4px 20px 0 rgba(123, 123, 123, 0.25)",
                    "slug": "core-theme-shadow-soft"
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--core-theme-tiber-light)"
                            }
                        },
                        "color": {
                            "background": "transparent",
                            "text": "#487EEC"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    },
                    "alternative": {
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--core-theme-mantis)",
                                "text": "var(--wp--preset--color--core-theme-tiber)"
                            }
                        },
                        "color": {
                            "background": "var(--wp--preset--color--core-theme-mantis-lighter)",
                            "text": "var(--wp--preset--color--core-theme-mantis-darkest)"
                        }
                    },
                    "outline": {
                        ":hover": {
                            "border": {
                                "color": "var(--wp--preset--color--core-theme-mantis-dark)"
                            },
                            "color": {
                                "background": "transparent",
                                "text": "var(--wp--preset--color--core-theme-mantis-dark)"
                            }
                        },
                        "border": {
                            "color": "var(--wp--preset--color--core-theme-mantis)",
                            "style": "solid",
                            "width": "1px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--core-theme-mantis)"
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--core-theme-neutral-lightest)",
                    "text": "var(--wp--preset--color--core-theme-neutral-dark)"
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--core-theme-40)",
                        "left": "var(--wp--preset--spacing--core-theme-40)",
                        "right": "var(--wp--preset--spacing--core-theme-40)",
                        "top": "var(--wp--preset--spacing--core-theme-40)"
                    }
                },
                "typography": {
                    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)",
                    "fontWeight": "300"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--core-theme-50)"
                }
            },
            "core/comment-author-name": {
                "color": {
                    "text": "var(--wp--preset--color--core-theme-white-darker)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--core-theme-white-darker)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "spacing": {
                    "margin": {
                        "bottom": "0px",
                        "top": "5px"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-small)"
                }
            },
            "core/comment-content": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--core-theme-30)",
                        "top": "var(--wp--preset--spacing--core-theme-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)"
                }
            },
            "core/comment-date": {
                "color": {
                    "text": "var(--wp--preset--color--core-theme-neutral-dark)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--core-theme-neutral-dark)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-small)"
                }
            },
            "core/comment-edit-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--core-theme-neutral-dark)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-small)"
                }
            },
            "core/comment-reply-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--core-theme-neutral-dark)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-small)"
                }
            },
            "core/comments-pagination": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--core-theme-40)",
                        "top": "var(--wp--preset--spacing--core-theme-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)"
                }
            },
            "core/comments-pagination-next": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)"
                }
            },
            "core/comments-pagination-numbers": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)"
                }
            },
            "core/comments-pagination-previous": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)"
                }
            },
            "core/list": {
                "css": "& li{margin-top: 0.5rem;}"
            },
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--instrument-sans)",
                    "fontSize": "var(--wp--preset--font-size--core-theme-large)",
                    "lineHeight": "1.5"
                },
                "color": {
                    "text": "var(--wp--preset--color--core-theme-neutral-dark)"
                }
            },
            "core/post-comments-form": {
                "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--core-theme-neutral-lighter) !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--core-theme-small); }",
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--core-theme-40)",
                        "top": "var(--wp--preset--spacing--core-theme-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)"
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--core-theme-white-darker)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--core-theme-white-darker)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-small)"
                }
            },
            "core/post-navigation-link": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)"
                }
            },
            "core/post-terms": {
                "css": "& a { white-space: nowrap; }",
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-small)",
                    "fontWeight": "600"
                }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "none"
                            }
                        },
                        "typography": {
                            "fontWeight": "300",
                            "lineHeight": "1.2",
                            "textDecoration": "none"
                        }
                    }
                }
            },
            "core/pullquote": {
                "css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--core-theme-30);}",
                "elements": {
                    "cite": {
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--core-theme-small)",
                            "fontStyle": "normal"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--core-theme-30)",
                        "top": "var(--wp--preset--spacing--core-theme-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-heading-four)",
                    "fontWeight": "300",
                    "lineHeight": "1.2"
                }
            },
            "core/query-pagination": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--core-theme-medium)",
                    "fontWeight": "500"
                }
            },
            "core/quote": {
                "border": {
                    "color": "currentColor",
                    "style": "solid",
                    "width": "0 0 0 2px"
                },
                "css": "&.has-text-align-right { border-width: 0 2px 0 0; } &.has-text-align-center { border-width: 0;border-inline: 0; padding-inline: 0; }",
                "elements": {
                    "cite": {
                        "css": "& sub { font-size: 0.65em }",
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--core-theme-small)",
                            "fontStyle": "normal",
                            "fontWeight": "300"
                        }
